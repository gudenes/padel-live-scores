<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Theme used while the WebView activity is running. The web app
         draws its own background, so this theme stays neutral. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>

    <!-- Launch theme. Shown by the OS from "tap icon" until the Activity's
         WebView paints — i.e., the cold-start window.

         IMPORTANT: we deliberately do NOT extend `Theme.SplashScreen`
         (Android 12+ system splash). That theme constrains the splash
         to a small circular icon (the launcher icon, masked) on a flat
         background — too small to show our wide PADEL NACHOS wordmark.
         Instead, we use the classic `windowBackground` approach: Android
         paints the full splash drawable into the activity window from
         the very first frame on every Android version (8+). The
         Capacitor SplashScreen plugin then takes over once the Activity
         is created, keeping the same image visible until first paint. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@drawable/splash</item>
    </style>
</resources>
