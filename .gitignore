# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Unanchored so this also catches apps/ops/node_modules, apps/labs/node_modules,
# padelgod/node_modules, relay/node_modules, etc. The previous root-anchored
# `/node_modules` only matched at the repo root and let subpackage installs
# slip into `git add -A`.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
# Unanchored so this catches apps/ops/.next, apps/labs/.next, and any future
# Next subpackage. Same reasoning as node_modules/ above.
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.superpowers/

# claude code worktrees (contain full node_modules copies, overloads file watcher)
.claude/worktrees/
.claude/scheduled_tasks.lock

# superpowers worktrees (project-local isolated workspaces)
.worktrees/

# Capacitor — Android Studio
android/.gradle/
android/.idea/
android/build/
android/app/build/
android/local.properties
android/captures/
android/.cxx/
android/app/release/
*.iml
mobile-webdir/

# Capacitor — Xcode / iOS build artifacts + per-user state
ios/build/
ios/App/build/
ios/App/Pods/
ios/App/Podfile.lock
ios/App/.swiftpm/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
ios/App/App.xcworkspace/xcuserdata/
ios/DerivedData/
*.xcuserstate
*.xccheckout
