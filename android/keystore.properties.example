# Template for android/keystore.properties — copy this to keystore.properties
# (which is gitignored) and fill in your real values. Gradle reads the real
# file at build time to sign release AABs/APKs. Never commit the real one.
#
# storeFile path is interpreted relative to android/app/, OR you can use an
# absolute path (recommended — keep the keystore outside the repo).

storeFile=/Users/YOUR_USERNAME/keystores/padelnachos-upload.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=padelnachos-upload
keyPassword=YOUR_KEY_PASSWORD
