{
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)apps/labs'",
  "crons": [
    {
      "path": "/api/cron/process-factsheets",
      "schedule": "8 */2 * * *"
    },
    {
      "path": "/api/cron/sync-highlights",
      "schedule": "20 */1 * * *"
    },
    {
      "path": "/api/cron/youtube-channels-discover",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/sync-articles",
      "schedule": "40 */1 * * *"
    },
    {
      "path": "/api/cron/enrich-articles",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/regenerate-dynamic-sources",
      "schedule": "0 5 * * 1"
    },
    {
      "path": "/api/cron/sync-articles-dynamic",
      "schedule": "0 3 * * 3"
    },
    {
      "path": "/api/cron/refresh-source-volume",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/quality-scores",
      "schedule": "7 * * * *"
    },
    {
      "path": "/api/cron/nacho-health",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/sync-broadcasters",
      "schedule": "0 4 * * 0"
    },
    {
      "path": "/api/cron/oop-monitor",
      "schedule": "30 */2 * * *"
    },
    {
      "path": "/api/cron/editorial-gen",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/anon-push-cleanup",
      "schedule": "0 4 * * 1"
    },
    {
      "path": "/api/cron/resolve-predictions",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/recompute-earnings",
      "schedule": "0 6 * * 1"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
