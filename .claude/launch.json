{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js (frontend)",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": [".claude/start-dev.sh"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "Ops (admin)",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": ["-c", "cd apps/ops && npm run dev"],
      "port": 3004,
      "autoPort": true
    },
    {
      "name": "Relay (Pusher bridge)",
      "runtimeExecutable": "/usr/local/bin/node",
      "runtimeArgs": ["--watch", "relay/index.js"],
      "port": 3001
    },
    {
      "name": "Mockups (static)",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4100", "--directory", "mockups"],
      "port": 4100
    },
    {
      "name": "Public (static)",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4200", "--directory", "public"],
      "port": 4200
    }
  ]
}
