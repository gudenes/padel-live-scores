<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Padel Nachos</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<!-- Phone-first mobile app: lock to portrait. iPad orientation array
	     stays unconstrained because the app supports iPad in resizable
	     mode (web content max-width:500 centers regardless). -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- Background modes required for push-notification delivery when the
	     app isn't foregrounded. `remote-notification` lets iOS wake the
	     app briefly to display the push (or hand it to our JS layer for
	     "silent" updates if we ever add them). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- Required by Apple's privacy nutrition labels for any networking
	     that contacts the user's local network (LAN). We don't do this
	     ourselves, but some WebKit affordances may trigger the check.
	     Leaving the description avoids App Review nagging. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Padel Nachos uses your local network to detect display devices when sharing scores.</string>
	<!-- iOS 14+ ATT framework. Required string if PostHog or Sentry ever
	     request the IDFA; today they don't, but the string is harmless
	     to declare and saves a re-submit if we add ad-supported tier. -->
	<key>NSUserTrackingUsageDescription</key>
	<string>This identifier is used to deliver personalised match notifications and improve our service. We do not share it with advertisers.</string>
	<!-- Capacitor Share plugin uses the system share sheet which itself
	     may invoke ActivityViewController and trigger Photos access on
	     some pickers. Strings are required to AVOID rejection even
	     when our flow doesn't take photos. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Padel Nachos may request access if you share a screenshot of a match.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Padel Nachos may save a screenshot of a match to your Photos when you tap Share.</string>
</dict>
</plist>
