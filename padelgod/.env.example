# Supabase (reuse from main app)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Padelgod admin API auth (generate via: openssl rand -hex 32)
PADELGOD_ADMIN_TOKEN=your-admin-token

# Optional
# Note: 3003 (not 3002) to avoid colliding with the main Next.js dev server.
# Railway sets PORT automatically in production — this default is local-only.
PORT=3003
NODE_ENV=development
LOG_LEVEL=info

# Worker enable flags (set to false to disable individual workers; default true)
ENABLE_SCHEDULER=true
ENABLE_TOURNAMENT_DISCOVERY=true
ENABLE_WIDGET_CODE_LOOKUP=true
ENABLE_PLAYER_RANKINGS=true
ENABLE_PLAYER_PROFILE=true
