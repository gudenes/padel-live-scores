{
  "manifest_version": 3,
  "name": "Padel Nachos Scout",
  "description": "Scout padel matches with video controls, keyboard shortcuts, scoring and synced match insights.",
  "version": "0.2.17",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "alarms"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Open Padel Nachos Scout",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "host_permissions": [
    "https://admin.padelnachos.com/*"
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://admin.padelnachos.com/*"
      ],
      "js": [
        "admin-video-relay.js"
      ]
    }
  ]
}
