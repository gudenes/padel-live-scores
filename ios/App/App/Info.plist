<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Padel Nachos</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>12</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<!-- Phone-first mobile app: lock to portrait. iPad orientation array
	     stays unconstrained because the app supports iPad in resizable
	     mode (web content max-width:500 centers regardless). -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- Background modes required for push-notification delivery when the
	     app isn't foregrounded. `remote-notification` lets iOS wake the
	     app briefly to display the push (or hand it to our JS layer for
	     "silent" updates if we ever add them). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- Required by Apple's privacy nutrition labels for any networking
	     that contacts the user's local network (LAN). We don't do this
	     ourselves, but some WebKit affordances may trigger the check.
	     Leaving the description avoids App Review nagging. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Padel Nachos uses your local network to detect display devices when sharing scores.</string>
	<!-- Capacitor Share plugin uses the system share sheet which itself
	     may invoke ActivityViewController and trigger Photos access on
	     some pickers. Strings are required to AVOID rejection even
	     when our flow doesn't take photos. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Padel Nachos may request access if you share a screenshot of a match.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Padel Nachos may save a screenshot of a match to your Photos when you tap Share.</string>
	<!-- Export Compliance: declare that this app uses only "exempt"
	     encryption (HTTPS to our servers + iOS-provided system frameworks).
	     Setting this key to false skips the encryption questionnaire that
	     App Store Connect otherwise prompts on every build submission.
	     If we ever bundle proprietary/non-standard crypto, flip this to
	     true and file the annual self-classification report with the US
	     Bureau of Industry and Security. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Google Sign-In URL scheme — required by GoogleSignIn / Firebase
	     Auth so the system can deliver the OAuth callback back to our
	     app via the REVERSED_CLIENT_ID URL scheme (from
	     GoogleService-Info.plist). Without this, native Google Sign-In
	     errors with "No URL types found in Info.plist". -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.1011492605581-f1bvgnadl1ja4cluoav0f4ftfl33656v</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
