# Supabase (reuse from main app)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Padelgod admin API auth (generate via: openssl rand -hex 32)
PADELGOD_ADMIN_TOKEN=your-admin-token

# Optional
# Note: 3003 (not 3002) to avoid colliding with the main Next.js dev server.
# Railway sets PORT automatically in production — this default is local-only.
PORT=3003
NODE_ENV=development
LOG_LEVEL=info

# Worker enable flags (set to false to disable individual workers; default true)
ENABLE_SCHEDULER=true
ENABLE_TOURNAMENT_DISCOVERY=true
ENABLE_WIDGET_CODE_LOOKUP=true
ENABLE_PLAYER_RANKINGS=true
ENABLE_PLAYER_PROFILE=true
ENABLE_ENTRY_LIST_FETCHER=true
ENABLE_DRAW_FETCHER=true
ENABLE_OOP_FETCHER=true
ENABLE_RESULTS_FETCHER=true

# Enable after deploying the grouped match notification endpoint.
ENABLE_GROUPED_SCHEDULE_NOTIFICATIONS=false

# Puntuate live score ingestion
ENABLE_PUNTUATE_LIVE=false
PUNTUATE_LIVE_DRY_RUN=true

# CourtBit FIP live scores require the snapshot migration before write mode.
ENABLE_COURTBIT_LIVE=false
COURTBIT_LIVE_DRY_RUN=true

# FIP routing: ordered fixed pool (JSON array), then optional residential fallback.
# Leave pool unset to use legacy FIP_PROXY_URL. Never commit actual credentials.
# FIP_FIXED_PROXY_URLS=["http://USER:PASS@FIXED_PRIMARY:PORT","http://USER:PASS@FIXED_BACKUP:PORT"]
# FIP_RESIDENTIAL_PROXY_URL=http://USER-rotate:PASS@p.webshare.io:80
# Per-process UTC-day estimated response-body budget; 0 disables residential.
# Default 75 MB/day (~2.25 GB/30 days). Resets on restart; excludes protocol
# overhead and can overshoot by in-flight requests. Webshare billing is authoritative.
FIP_RESIDENTIAL_DAILY_BYTE_LIMIT=75000000
# /health exposes credential-free per-route counters and residential daily usage.
# Failed routes cool down for five minutes; each read tries each available route
# at most once. Only known read-only FIP AJAX POSTs are replayed.
# Entry-list PDFs revalidate via ETag/Last-Modified. Parsed text cache is bounded
# to 128 URLs / 8 MiB per client and cold after restart; failures never serve stale.
