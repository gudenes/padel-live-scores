{
  "name": "padelgod",
  "version": "0.1.0",
  "description": "Padel data scraping service — sources tournaments/players/draws/OOP/live scores from FIP",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node --trace-warnings dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@sentry/node": "^10.50.0",
    "@supabase/supabase-js": "^2.39.0",
    "axios": "^1.7.7",
    "axios-retry": "^4.5.0",
    "cheerio": "^1.0.0",
    "fastify": "^4.28.1",
    "https-proxy-agent": "^7.0.6",
    "node-cron": "^3.0.3",
    "pdf-parse": "^2.4.5",
    "pino": "^9.5.0",
    "playwright": "^1.48.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/node-cron": "^3.0.11",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.2"
  }
}
